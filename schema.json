{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question bank",
  "type": "array",
  "items": {
    "$ref": "#/definitions/question"
  },
  "definitions": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "topics"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+-[0-9]{3,}$",
          "description": "Unique across all files. Never change once published."
        },
        "type": {
          "enum": [
            "mcq",
            "fill_blank",
            "matching"
          ]
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "probability",
              "inference",
              "ml"
            ]
          },
          "description": "Topics the question belongs to. Can be more than one."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "type": "string",
          "description": "Question text. Blanks are {{1}}, {{2}}, etc. and can be inside math; when substituting a bank item inside math, strip its $ delimiters first. Optional for matching (defaults to \"Match the following\")."
        },
        "explanation": {
          "type": "string",
          "description": "Shown after the user answers."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/definitions/option"
          },
          "contains": {
            "type": "object",
            "required": [
              "correct"
            ],
            "properties": {
              "correct": {
                "const": true
              }
            }
          },
          "description": "MCQ options. Shuffle when displaying. Exactly one must have correct: true."
        },
        "bank": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          },
          "description": "Choices for fill_blank. Items are never used up: any item can fill any number of blanks. Shuffle when displaying."
        },
        "answers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "description": "Maps blank number to the correct bank item. A list means any item in it counts as correct."
        },
        "unordered": {
          "$ref": "#/definitions/blankGroups",
          "description": "Groups of blanks whose answers can be filled in any order."
        },
        "swappable_groups": {
          "$ref": "#/definitions/blankGroups",
          "description": "Groups of blanks that can trade places as whole units, e.g. [[1, 2], [3, 4]]."
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "description": "Matching pairs [left, right]. Show left in order, shuffle right."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcq"
              }
            }
          },
          "then": {
            "required": [
              "prompt",
              "options"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "bank"
                  ]
                },
                {
                  "required": [
                    "answers"
                  ]
                },
                {
                  "required": [
                    "unordered"
                  ]
                },
                {
                  "required": [
                    "swappable_groups"
                  ]
                },
                {
                  "required": [
                    "pairs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fill_blank"
              }
            }
          },
          "then": {
            "required": [
              "prompt",
              "bank",
              "answers"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "pairs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": [
              "pairs"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "bank"
                  ]
                },
                {
                  "required": [
                    "answers"
                  ]
                },
                {
                  "required": [
                    "unordered"
                  ]
                },
                {
                  "required": [
                    "swappable_groups"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "correct": {
          "type": "boolean",
          "description": "Missing means false."
        },
        "why_wrong": {
          "type": "string",
          "description": "Shown when the user picks this wrong option."
        }
      }
    },
    "blankGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}